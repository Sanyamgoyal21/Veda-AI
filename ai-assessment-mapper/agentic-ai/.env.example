PORT=8000

# Vision-capable AI provider credentials (Gemini, via its OpenAI-compatible
# endpoint - see vision_service.py). Get a key at https://aistudio.google.com/apikey
# Never expose these values to the frontend or commit real values.
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Max image dimension (px) sent to the vision model, larger pages are downscaled.
MAX_IMAGE_DIMENSION=1600

# Render DPI used when rasterizing PDF pages to images.
PDF_RENDER_DPI=200
