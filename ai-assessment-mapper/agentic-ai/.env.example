PORT=8000

# Vision-capable AI provider credentials (OpenRouter, via its OpenAI-
# compatible endpoint - see vision_service.py). Get a key at
# https://openrouter.ai/keys
# Never expose these values to the frontend or commit real values.
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=openai/gpt-4o
AI_BASE_URL=https://openrouter.ai/api/v1

# Max image dimension (px) sent to the vision model, larger pages are downscaled.
MAX_IMAGE_DIMENSION=1600

# Render DPI used when rasterizing PDF pages to images.
PDF_RENDER_DPI=200
